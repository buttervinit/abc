# --- Database ---
# Postgres (recommended; run `docker compose up -d db`)
DATABASE_URL="postgresql://grc:grc@localhost:5432/grc?schema=public"
# SQLite fallback (zero infra): set provider="sqlite" in prisma/schema.prisma and use:
# DATABASE_URL="file:./dev.db"

# --- Claude API (evidence relevance validation) ---
# Leave blank to run with AI validation SKIPPED (app stays runnable offline).
ANTHROPIC_API_KEY=""

# --- Auth.js / Microsoft Entra ID SSO ---
# Generate with: npx auth secret   (or openssl rand -base64 32)
AUTH_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
# Redirect URI to register in the Entra app:
#   http://localhost:3000/api/auth/callback/microsoft-entra-id

# Comma-separated admin emails. Anyone signing in with these emails becomes ADMIN.
ADMIN_EMAILS="grc.admin@godrejinds.com"

# Set to "true" to allow seeded demo credential login without live Entra config
# (useful for local development / running the MVP before SSO is wired up).
ALLOW_DEV_LOGIN="true"
